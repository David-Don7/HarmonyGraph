POSTGRES_PASSWORD=local-harmonygraph
# Native development defaults to SQLite. PostgreSQL is the deployment database.
# DATABASE_URL=postgresql+psycopg://harmony:password@127.0.0.1:5432/harmonygraph
DATA_ROOT=data
# Bounded local disk use; increase only after checking Docker's storage drive.
CATALOG_DATABASE_BUDGET_GB=20
# Optional extra trusted CA for HTTPS-inspecting local network software.
# HARMONY_CA_FILE=data/local/network-root.pem
